# Fixture builder for the RomM swap spike: xorriso builds real ISO 9660 images.
# Same base as the smoke harness's fixture image.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update -o Acquire::Retries=3 \
 && apt-get install -y --no-install-recommends xorriso python3 \
 && rm -rf /var/lib/apt/lists/*
